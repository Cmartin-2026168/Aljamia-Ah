<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="600.0" minWidth="1000.0" prefHeight="760.0" prefWidth="1280.0" spacing="0" styleClass="root-pane" stylesheets="@apariencia.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cc.cmartin.system.controller.MainMenuController">

    <!-- ============ CABECERA ============ -->
    <HBox alignment="CENTER_LEFT" minHeight="100.0" prefHeight="100.0" spacing="20" styleClass="header">
        <StackPane fx:id="medallon" styleClass="medallon-marco">
            <ImageView fitHeight="56.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@image/Abrahamic.png" />
                </image>
            </ImageView>
        </StackPane>

        <VBox fx:id="bloqueTitulo" alignment="CENTER_LEFT" spacing="4">
            <Label styleClass="title-label" text="Aljamizado" />
            <Label styleClass="subtitle-label" text="Del español al árabe y al hebreo" />
        </VBox>
    </HBox>

    <!-- Franja de cuatro tintas, tramos iguales -->
    <HBox styleClass="franja">
        <Region maxWidth="Infinity" prefWidth="100.0" styleClass="franja-oro" HBox.hgrow="ALWAYS" />
        <Region maxWidth="Infinity" prefWidth="100.0" styleClass="franja-verde" HBox.hgrow="ALWAYS" />
        <Region maxWidth="Infinity" prefWidth="100.0" styleClass="franja-azul" HBox.hgrow="ALWAYS" />
        <Region maxWidth="Infinity" prefWidth="100.0" styleClass="franja-rojo" HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- ============ CONTENIDO: dos zonas ============ -->
    <HBox spacing="32" styleClass="content" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="32" left="48" right="48" top="32" />
        </padding>

        <!-- ===== ZONA IZQUIERDA: transliterador ===== -->
        <VBox minWidth="0.0" prefWidth="700.0" spacing="20" HBox.hgrow="ALWAYS" maxWidth="Infinity">

            <!-- Selector de destino (vino) + acción principal -->
            <HBox alignment="CENTER" spacing="20">
                <VBox fx:id="panelSelector" maxWidth="Infinity" styleClass="selector-panel" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="12" left="18" right="18" top="12" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label styleClass="field-label" text="Escribir en" />
                        <ComboBox fx:id="cmbAlfabetoDestino" maxWidth="Infinity" prefHeight="38.0" styleClass="combo-box" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <Button fx:id="btnTransliterar" minWidth="190.0" onAction="#transliterar" prefWidth="200.0" styleClass="btn-primary" text="Transliterar" />
            </HBox>

            <!-- Texto en español (oro) -->
            <VBox fx:id="tarjetaOrigen" maxWidth="Infinity" spacing="10" styleClass="card, card-origin" VBox.vgrow="ALWAYS">
                <Label styleClass="field-label" text="Texto en español" />
                <TextArea fx:id="txtTexto" promptText="Escribe o pega aquí el texto que quieres transliterar…" styleClass="input-area" VBox.vgrow="ALWAYS" wrapText="true" />
            </VBox>

            <!-- Resultado (verde para árabe, azul para hebreo) -->
            <VBox fx:id="tarjetaResultado" maxWidth="Infinity" spacing="10" styleClass="card, card-result-arabe" VBox.vgrow="ALWAYS">
                <Label styleClass="field-label" text="Resultado" />
                <TextArea fx:id="txtTextoTransliterado" editable="false" promptText="La transliteración aparecerá aquí." styleClass="output-area" VBox.vgrow="ALWAYS" wrapText="true" />
            </VBox>

            <Label styleClass="pie-label" text="Aljamía: español escrito con letras árabes o hebreas" />
        </VBox>

        <!-- ===== ZONA DERECHA: espacio libre para agregar cosas ===== -->
        <VBox fx:id="zonaLibre" maxWidth="Infinity" minWidth="0.0" prefWidth="480.0" spacing="16" styleClass="side-panel" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="18" left="18" right="18" top="16" />
            </padding>
            <Label styleClass="field-label" text="Espacio libre" />
            <!-- Agrega aquí tus nuevos controles -->
        </VBox>
    </HBox>
</VBox>