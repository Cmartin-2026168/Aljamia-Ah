<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="580.0" prefWidth="394.0" spacing="0" styleClass="root-pane" stylesheets="@apariencia.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cc.cmartin.system.controller.MainMenuController">

    <!-- Cabecera: bloque tipográfico plano + franja negra, típico del cartelismo constructivista -->
    <StackPane minHeight="57.0" prefHeight="57.0" prefWidth="402.0" styleClass="header">
        <Region prefHeight="66.0" styleClass="header-block" StackPane.alignment="TOP_LEFT" />
        <Label alignment="TOP_LEFT" contentDisplay="TOP" nodeOrientation="LEFT_TO_RIGHT" prefHeight="70.0" prefWidth="203.0" styleClass="title-label" text="ALJAMIZADO" StackPane.alignment="CENTER_LEFT" />
        <Label styleClass="subtitle-label" text="ES ⇄ ARABE ⇄ HEBREO" StackPane.alignment="BOTTOM_RIGHT" />
      <Circle fill="DODGERBLUE" radius="36.0" stroke="BLACK" strokeType="INSIDE" styleClass="circulo" />
      <ImageView fitHeight="61.0" fitWidth="85.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@image/Abrahamic.png" />
         </image>
      </ImageView>
    </StackPane>

    <VBox prefHeight="520.0" prefWidth="402.0" spacing="18" styleClass="content">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <GridPane hgap="14" prefHeight="90.0" prefWidth="362.0" vgap="6">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" />
                <ColumnConstraints percentWidth="50" />
            </columnConstraints>

            <Label styleClass="field-label" text="ORIGEN" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label styleClass="field-label" text="DESTINO" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <ComboBox fx:id="cmbAlfabetoInicial" maxWidth="Infinity" prefHeight="32.0" prefWidth="146.0" styleClass="combo-box" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbAlfabetoDestino" maxWidth="Infinity" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Button fx:id="btnTransliterar" maxWidth="Infinity" onAction="#transliterar" styleClass="btn-primary" text="TRANSLITERAR →" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2" />
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <VBox spacing="6">
            <Label styleClass="field-label" text="TEXTO ORIGINAL" />
            <TextArea fx:id="txtTexto" prefHeight="130" promptText="Escribe aquí..." styleClass="imput-container" wrapText="true" />
        </VBox>

        <VBox spacing="6">
            <Label styleClass="field-label field-label-accent" text="RESULTADO" />
            <TextArea fx:id="txtTextoTransliterado" editable="false" prefHeight="130" styleClass="text-output" wrapText="true" />
        </VBox>
    </VBox>
</VBox>
